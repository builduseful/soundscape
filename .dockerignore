# Version control
.git/
.gitignore

# Agent and tooling config — not needed at runtime
.agents/
.opencode/
.playwright/
.playwright-cli/
.temp/
.vs/
opencode.json

# Documentation — runtime doesn't need it
*.md
docs/

# Host-side helper scripts (media-key injection, icon export)
scripts/

# GitHub Pages deployment config — irrelevant inside the container
CNAME

# Build file — not needed at runtime
Dockerfile
