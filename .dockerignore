# Version control
.git/
.gitignore

# Agent and tooling config — not needed at runtime
.agents/
.opencode/
.playwright/
.playwright-cli/
# Anchored with **/ on purpose: a bare `.temp/` matches only the build context
# root, and agent scratch has landed under src/ before (a browser profile left
# in resources/soundscapes/, tens of megabytes of it) where it would otherwise
# be copied into the image and served.
**/.temp/
.vs/
opencode.json

# Documentation — runtime doesn't need it. Includes the remote-playback
# plugin's README, which Caddy never serves (the Pages artifact uploads all of
# src/, so that copy of the doc still ships).
*.md
docs/

# Host-side helper scripts (media-key injection, icon/screenshot export) and
# their devDependencies — npm test needs neither, it only imports src/js.
scripts/
node_modules/

# GitHub Pages deployment config — irrelevant inside the container
CNAME

# Build file — not needed at runtime
Dockerfile
